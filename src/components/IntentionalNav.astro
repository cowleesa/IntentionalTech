---
// src/components/IntentionalNav.astro
const pathname = new URL(Astro.request.url).pathname;
const currentPath =
  pathname === "/" ? "home" : pathname.replace(/^\/|\/$/g, "");
---

<nav class="navbar">
  <div class="nav-container">
    <a href={`${import.meta.env.BASE_URL}`} class="logo">
      Intentional<span class="logo-accent">Tech</span>
    </a>

    <input type="checkbox" id="nav-check" />
    <label for="nav-check" class="nav-btn" aria-label="Toggle navigation">
      <span></span>
      <span></span>
      <span></span>
    </label>

    <ul class="nav-links">
      <li>
        <a
          href="https://www.youtube.com/@IntentionalTech"
          target="_blank"
          rel="noopener noreferrer"
          class={currentPath === "intentional-tech" ? "active" : ""}>YouTube</a
        >
      </li>
      <li>
        <a
          href={`${import.meta.env.BASE_URL}blog`}
          class={currentPath.startsWith("blog") ? "active" : ""}>Blog</a
        >
      </li>
      <li>
        <a
          href={`${import.meta.env.BASE_URL}support`}
          class={currentPath === "support" ? "active" : ""}
        >Support</a>
      </li>
      <li>
        <a href="mailto:chris@intentionaltech.co.uk" class="cta-btn">Contact</a>
      </li>
    </ul>
  </div>
</nav>

<style>
  .navbar {
    position: fixed;
    top: 0;
    width: 100%;
    background: rgba(230, 230, 250, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    z-index: 1000;
    transition: background-color var(--transition-base);
  }

  @media (prefers-color-scheme: dark) {
    .navbar {
      background: rgba(26, 26, 46, 0.85);
    }
  }

  .nav-container {
    max-width: var(--content-width);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.875rem var(--content-padding);
  }

  .logo {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 800;
    text-decoration: none;
    color: var(--color-heading);
    letter-spacing: -0.02em;
    transition: color var(--transition-fast);
  }

  .logo-accent {
    color: var(--color-accent);
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 2rem;
    align-items: center;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    font-family: var(--font-body);
    text-decoration: none;
    color: var(--color-text);
    font-weight: 500;
    font-size: 0.9375rem;
    transition: color var(--transition-fast);
    position: relative;
  }

  .nav-links a:hover {
    color: var(--color-accent);
  }

  .nav-links a.active {
    color: var(--color-accent);
  }

  .nav-links a.active::after {
    content: "";
    position: absolute;
    bottom: -6px;
    left: 0;
    right: 0;
    height: 2px;
    background-color: var(--color-accent);
    border-radius: 1px;
  }

  .cta-btn {
    background: var(--color-accent) !important;
    color: #ffffff !important;
    padding: 0.5rem 1.125rem;
    border-radius: 6px;
    font-weight: 600 !important;
    font-size: 0.875rem !important;
    transition:
      background-color var(--transition-fast),
      transform var(--transition-fast) !important;
  }

  .cta-btn:hover {
    background: var(--color-accent-hover) !important;
    transform: translateY(-1px);
  }

  .cta-btn.active::after {
    display: none;
  }

  /* Mobile */
  #nav-check {
    display: none;
  }

  .nav-btn {
    display: none;
  }

  @media (max-width: 768px) {
    .nav-btn {
      display: flex;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      padding: 4px;
    }

    .nav-btn span {
      width: 22px;
      height: 2px;
      background: var(--color-text);
      border-radius: 1px;
      transition:
        transform var(--transition-fast),
        opacity var(--transition-fast);
    }

    #nav-check:checked ~ .nav-btn span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    #nav-check:checked ~ .nav-btn span:nth-child(2) {
      opacity: 0;
    }

    #nav-check:checked ~ .nav-btn span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
      flex-direction: column;
      padding: 1.5rem var(--content-padding);
      gap: 1.25rem;
    }

    #nav-check:checked ~ .nav-links {
      display: flex;
    }
  }
</style>
