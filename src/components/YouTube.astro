---
// src/components/YouTube.astro
const { id, title = "YouTube Video", caption } = Astro.props;
const thumb = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
---

<link rel="preconnect" href="https://i.ytimg.com" />

<figure class="video-container">
  <div class="video-wrapper yt-facade" data-id={id} data-title={title}>
    <img
      src={thumb}
      alt={`Play video: ${title}`}
      loading="lazy"
      decoding="async"
      width="480"
      height="360"
      class="yt-thumb"
    />
    <button class="yt-play" aria-label={`Play ${title}`}>
      <svg viewBox="0 0 68 48" width="68" height="48" aria-hidden="true">
        <path d="M66.5 7.7a8.5 8.5 0 0 0-6-6C56 0 34 0 34 0S12 0 7.5 1.7a8.5 8.5 0 0 0-6 6C0 12.3 0 24 0 24s0 11.7 1.5 16.3a8.5 8.5 0 0 0 6 6C12 48 34 48 34 48s22 0 26.5-1.7a8.5 8.5 0 0 0 6-6C68 35.7 68 24 68 24s0-11.7-1.5-16.3z" fill="#ff0000"/>
        <path d="M45 24L27 14v20z" fill="#fff"/>
      </svg>
    </button>
  </div>
  {caption && <figcaption class="video-caption">{caption}</figcaption>}
</figure>

<script>
  document.querySelectorAll<HTMLElement>('.yt-facade').forEach(el => {
    el.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube.com/embed/${el.dataset.id}?autoplay=1`;
      iframe.title = el.dataset.title ?? '';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.style.cssText = 'width:100%;height:100%;border:none;display:block';
      el.replaceChildren(iframe);
    }, { once: true });
  });
</script>

<style>
  .video-container {
    max-width: 100%;
    margin: 2rem 0;
  }

  .video-wrapper {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 0.75rem;
    overflow: hidden;
    background: #000;
    border: 1px solid var(--color-border);
    cursor: pointer;
  }

  .yt-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .yt-play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: transform 0.15s ease;
  }

  .yt-play:hover {
    transform: scale(1.1);
  }

  /* Once clicked, the facade div holds an iframe — remove cursor */
  .video-wrapper:has(iframe) {
    cursor: default;
  }

  iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .video-caption {
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-align: left;
    line-height: 1.4;
    letter-spacing: 0.01em;
  }
</style>
