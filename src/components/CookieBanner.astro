---
import 'vanilla-cookieconsent/dist/cookieconsent.css';
---

<script>
  import * as CookieConsent from 'vanilla-cookieconsent';

  CookieConsent.run({
    onFirstConsent: () => {
      if (CookieConsent.acceptedCategory('analytics')) {
        window.gtag?.('consent', 'update', { analytics_storage: 'granted' });
      }
    },
    onConsent: () => {
      if (CookieConsent.acceptedCategory('analytics')) {
        window.gtag?.('consent', 'update', { analytics_storage: 'granted' });
      }
    },
    onChange: () => {
      window.gtag?.('consent', 'update', {
        analytics_storage: CookieConsent.acceptedCategory('analytics') ? 'granted' : 'denied',
      });
    },
    categories: {
      necessary: {
        enabled: true,
        readOnly: true,
      },
      analytics: {
        autoClear: {
          cookies: [{ name: /^(_ga)/ }],
        },
      },
    },
    language: {
      default: 'en',
      translations: {
        en: {
          consentModal: {
            title: 'Cookie preferences',
            description:
              'We use analytics cookies to understand how people use this site and help us improve it. You can accept or decline below. <a href="/privacy-policy">Privacy policy</a>.',
            acceptAllBtn: 'Accept all',
            acceptNecessaryBtn: 'Decline',
            showPreferencesBtn: 'Manage preferences',
          },
          preferencesModal: {
            title: 'Cookie preferences',
            acceptAllBtn: 'Accept all',
            acceptNecessaryBtn: 'Decline all',
            savePreferencesBtn: 'Save preferences',
            closeIconLabel: 'Close',
            sections: [
              {
                title: 'Essential cookies',
                description:
                  'These cookies are necessary for the site to function and cannot be disabled.',
                linkedCategory: 'necessary',
              },
              {
                title: 'Analytics cookies',
                description:
                  'We use Google Analytics 4 to understand how visitors use the site. All data is anonymous. No cookies are set until you accept.',
                linkedCategory: 'analytics',
              },
            ],
          },
        },
      },
    },
  });
</script>

<style is:global>
  #cc-main {
    --cc-font-family: var(--font-body, system-ui, sans-serif);
    --cc-modal-border-radius: 12px;
    --cc-btn-border-radius: 8px;
    --cc-btn-primary-bg: #0173ee;
    --cc-btn-primary-hover-bg: #0060cc;
    --cc-btn-primary-text: #ffffff;
    --cc-toggle-on-bg: #0173ee;
    --cc-toggle-on-knob-bg: #ffffff;
  }

  @media (prefers-color-scheme: dark) {
    #cc-main {
      --cc-btn-primary-bg: #69a2ff;
      --cc-btn-primary-hover-bg: #8eb8ff;
      --cc-btn-primary-text: #1a1a2e;
      --cc-toggle-on-bg: #69a2ff;
    }
  }
</style>
