---
// src/components/Image.astro
const { src, alt, caption, width, height } = Astro.props;
---

<figure class="image-container">
  <div class="image-wrapper">
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading="lazy"
      decoding="async"
    />
  </div>
  {caption && <figcaption class="image-caption">{caption}</figcaption>}
</figure>

<style>
  .image-container {
    max-width: 100%;
    margin: 2rem 0;
  }

  .image-wrapper {
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    line-height: 0;
  }

  img {
    width: 100%;
    height: auto;
    display: block;
  }

  .image-caption {
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-align: left;
    line-height: 1.4;
    letter-spacing: 0.01em;
  }
</style>
