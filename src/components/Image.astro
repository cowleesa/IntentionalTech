---
// src/components/Image.astro
const { src, alt, caption, width, height } = Astro.props;

// Derive optimized paths from the original /images/xxx.jpg src
const name = src.replace(/^\/images\//, '').replace(/\.[^.]+$/, '');
const webp900 = `/images/optimized/${name}.webp`;
const webp450 = `/images/optimized/${name}-450w.webp`;
const jpg900  = `/images/optimized/${name}.jpg`;
const isOptimizable = src.startsWith('/images/') && /\.(jpg|jpeg)$/i.test(src);
---

<figure class="image-container">
  <div class="image-wrapper">
    {isOptimizable ? (
      <picture>
        <source
          type="image/webp"
          srcset={`${webp450} 450w, ${webp900} 900w`}
          sizes="(max-width: 600px) 450px, 900px"
        />
        <img
          src={jpg900}
          alt={alt}
          width={width}
          height={height}
          loading="lazy"
          decoding="async"
        />
      </picture>
    ) : (
      <img
        src={src}
        alt={alt}
        width={width}
        height={height}
        loading="lazy"
        decoding="async"
      />
    )}
  </div>
  {caption && <figcaption class="image-caption">{caption}</figcaption>}
</figure>

<style>
  .image-container {
    max-width: 100%;
    margin: 2rem 0;
  }

  .image-wrapper {
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    line-height: 0;
  }

  img {
    width: 100%;
    height: auto;
    display: block;
  }

  .image-caption {
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-align: left;
    line-height: 1.4;
    letter-spacing: 0.01em;
  }
</style>
