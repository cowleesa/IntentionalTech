---
// src/layouts/MainLayout.astro
import "../styles/global.css";
import IntentionalNav from "../components/IntentionalNav.astro";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  pubDate?: Date;
  author?: string;
  ogImage?: string;
}

const {
  title = "Intentional Tech",
  description = "Welcome to Intentional Tech",
  type = "website",
  pubDate,
  author = "Chris Cowley",
  ogImage,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const siteName = "Intentional Tech";

const schema = type === "article" && pubDate
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description,
      datePublished: pubDate.toISOString(),
      author: {
        "@type": "Person",
        name: author,
      },
      publisher: {
        "@type": "Organization",
        name: siteName,
      },
      url: canonicalUrl,
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: siteName,
      url: Astro.site?.href,
    };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <!-- Twitter -->
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Intentional Tech" href={new URL('/rss.xml', Astro.site).href} />
    <!-- Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <meta
      name="theme-color"
      content="lavender"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#1a1a2e"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@700;800&display=swap"
      rel="stylesheet"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL}it-logo.svg`}
    />
    <meta
      name="google-site-verification"
      content="QZaW_BTt21KPNwJGhMHud1mPYp2-wmOaswjfE4utUVA"
    />
    <title>{title}</title>
  </head>
  <body>
    <IntentionalNav />
    <main>
      <slot />
    </main>
  </body>
</html>
