---
// src/layouts/MainLayout.astro
import "../styles/global.css";
import IntentionalNav from "../components/IntentionalNav.astro";
import CookieBanner from "../components/CookieBanner.astro";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  pubDate?: Date;
  author?: string;
  ogImage?: string;
}

const {
  title = "Intentional Tech",
  description = "Welcome to Intentional Tech",
  type = "website",
  pubDate,
  author = "Chris Cowley",
  ogImage,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const siteName = "Intentional Tech";

const schema = type === "article" && pubDate
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description,
      datePublished: pubDate.toISOString(),
      author: {
        "@type": "Person",
        name: author,
      },
      publisher: {
        "@type": "Organization",
        name: siteName,
      },
      url: canonicalUrl,
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: siteName,
      url: Astro.site?.href,
    };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <!-- Twitter -->
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Intentional Tech" href={new URL('/rss.xml', Astro.site).href} />
    <!-- Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <meta
      name="theme-color"
      content="lavender"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#1a1a2e"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@700;800&display=swap"
      rel="stylesheet"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL}it-logo.svg`}
    />
    <link
      rel="icon"
      type="image/png"
      href={`${import.meta.env.BASE_URL}favicon.png`}
    />
    <link
      rel="apple-touch-icon"
      href={`${import.meta.env.BASE_URL}apple-touch-icon.png`}
    />
    <meta
      name="google-site-verification"
      content="QZaW_BTt21KPNwJGhMHud1mPYp2-wmOaswjfE4utUVA"
    />
    <title>{title}</title>
    <!-- Google Consent Mode v2 — deny by default until user consents -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        wait_for_update: 500,
      });
    </script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-2NG8PE2NES"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-2NG8PE2NES');
    </script>
  </head>
  <body>
    <IntentionalNav />
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        &copy; {new Date().getFullYear()} Intentional Tech &middot;
        <a href="/for-brands">For Brands</a> &middot;
        <a href="/privacy-policy">Privacy Policy</a> &middot;
        <button type="button" data-cc="show-preferencesModal" class="footer-cc-btn">
          Cookie preferences
        </button>
      </p>
    </footer>
    <CookieBanner />
  </body>
</html>

<style>
  .site-footer {
    text-align: center;
    padding: 2rem var(--content-padding);
    font-size: 0.875rem;
    color: var(--color-text-muted);
    border-top: 1px solid var(--color-border);
    margin-top: 2rem;
  }

  .site-footer a {
    color: var(--color-text-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--transition-fast);
  }

  .site-footer a:hover {
    color: var(--color-accent);
  }

  .footer-cc-btn {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font: inherit;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--transition-fast);
  }

  .footer-cc-btn:hover {
    color: var(--color-accent);
  }
</style>
