---
// src/layouts/MainLayout.astro
const { title = "Intentional Tech" } = Astro.props;
const { description = "Welcome to Intentional Tech" } = Astro.props;
import "../styles/global.css";
import IntentionalNav from "../components/IntentionalNav.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta
      name="theme-color"
      content="lavender"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#1a1a2e"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@700;800&display=swap"
      rel="stylesheet"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL}it-logo.svg`}
    />
    <meta
      name="google-site-verification"
      content="QZaW_BTt21KPNwJGhMHud1mPYp2-wmOaswjfE4utUVA"
    />
    <title>{title}</title>
  </head>
  <body>
    <IntentionalNav />
    <main>
      <slot />
    </main>
  </body>
</html>
