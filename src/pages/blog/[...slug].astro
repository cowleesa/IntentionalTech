---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import BackToTop from "../../components/BackToTop.astro";
import NewsletterSubscribe from "../../components/NewsletterSubscribe.astro";
import { getReadingTime } from "../../utils/reading-time";

export async function getStaticPaths() {
  const blogEntries = await getCollection("blog");

  const sortedEntries = blogEntries.sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );

  return sortedEntries.map((entry, index) => ({
    params: { slug: entry.slug || entry.id },
    props: {
      entry,
      nextPost: index === 0 ? null : sortedEntries[index - 1],
      prevPost:
        index === sortedEntries.length - 1 ? null : sortedEntries[index + 1],
    },
  }));
}

const { entry, nextPost, prevPost } = Astro.props;
const { Content } = await entry.render();
const base = import.meta.env.BASE_URL;
const readingTime = getReadingTime(entry.body);
const ogImage = new URL(`/og/${entry.slug || entry.id}.svg`, Astro.site).href;
---

<MainLayout
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  pubDate={entry.data.pubDate}
  author={entry.data.author}
  ogImage={ogImage}
>
  <article class="post-container">
    <div class="post-meta">
      <time datetime={entry.data.pubDate.toISOString()}>
        {entry.data.pubDate.toLocaleDateString(undefined, {
          year: "numeric",
          month: "long",
          day: "numeric",
        })}
      </time>
      <span class="meta-separator" aria-hidden="true">&middot;</span>
      <span class="reading-time">{readingTime} min read</span>
    </div>

    <div class="article-content">
      <Content />
    </div>

    {entry.data.tags?.length > 0 && (
      <div class="post-tags">
        <span class="tags-label">Tags</span>
        <div class="tags-list">
          {entry.data.tags.map((tag: string) => (
            <a href={`${base}tags/${tag}/`} class="tag-pill">{tag}</a>
          ))}
        </div>
      </div>
    )}

    <footer class="post-footer">
      <div class="author-info">
        <span class="author-label">Written by</span>
        <span class="author-name">Chris Cowley</span>
        <time datetime={entry.data.pubDate.toISOString()}>
          {entry.data.pubDate.toLocaleDateString(undefined, {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </time>
      </div>
      <a href="/rss.xml" class="rss-link" aria-label="RSS Feed">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round"
             stroke-linejoin="round">
          <path d="M4 11a9 9 0 0 1 9 9" />
          <path d="M4 4a16 16 0 0 1 16 16" />
          <circle cx="5" cy="19" r="1" />
        </svg>
        RSS Feed
      </a>
    </footer>

    <NewsletterSubscribe />

    <nav class="pagination" aria-label="Post navigation">
      {
        prevPost ? (
          <a href={`${base}blog/${prevPost.slug}`} class="pagination-link pagination-prev">
            <span class="pagination-direction">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 12H5" />
                <path d="m12 19-7-7 7-7" />
              </svg>
              Older
            </span>
            <span class="pagination-title">{prevPost.data.title}</span>
          </a>
        ) : (
          <div />
        )
      }
      {
        nextPost && (
          <a href={`${base}blog/${nextPost.slug}`} class="pagination-link pagination-next">
            <span class="pagination-direction">
              Newer
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </span>
            <span class="pagination-title">{nextPost.data.title}</span>
          </a>
        )
      }
    </nav>
  </article>
  <BackToTop />
</MainLayout>

<style>
  .post-container {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: calc(var(--nav-height) + 2rem) var(--content-padding) 4rem;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0;
    margin-bottom: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .meta-separator {
    margin: 0 0.5rem;
  }

  .post-tags {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .tags-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-pill {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    background: var(--color-accent-subtle);
    color: var(--color-accent);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .tag-pill:hover {
    background: var(--color-accent);
    color: #ffffff;
  }

  .post-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 2px solid var(--color-accent);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .author-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .rss-link {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
    flex-shrink: 0;
  }

  .rss-link:hover {
    color: var(--color-accent);
  }

  .author-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .author-name {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-heading);
  }

  .author-info time {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  /* Pagination */
  .pagination {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .pagination-link {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    text-decoration: none;
    padding: 1rem;
    border-radius: 0.5rem;
    transition: background-color var(--transition-fast);
    max-width: 48%;
  }

  .pagination-link:hover {
    background-color: var(--color-accent-subtle);
  }

  .pagination-next {
    margin-left: auto;
    text-align: right;
    align-items: flex-end;
  }

  .pagination-direction {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
  }

  .pagination-title {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-heading);
    line-height: 1.3;
  }

  @media (max-width: 600px) {
    .pagination {
      flex-direction: column;
    }

    .pagination-link {
      max-width: 100%;
    }

    .pagination-next {
      text-align: left;
      align-items: flex-start;
    }
  }
</style>
