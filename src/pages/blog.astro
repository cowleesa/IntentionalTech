---
import { getCollection } from "astro:content";
import MainLayout from "../layouts/MainLayout.astro";

const allPosts = await getCollection("blog");

const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const base = import.meta.env.BASE_URL;
---

<MainLayout title="Intentional Tech Blog" description="Blog">
  <section class="blog-container">
    <header class="blog-header">
      <h1 class="page-title">Blog</h1>
      <p class="post-count">{sortedPosts.length} posts</p>
    </header>

    <div class="posts-list">
      {
        sortedPosts.map((post, index) => (
          <article class="post-card">
            <div class="post-number">
              {String(sortedPosts.length - index).padStart(2, "0")}
            </div>
            <div class="post-body">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString(undefined, {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
              <h2 class="post-heading">
                <a href={`${base}blog/${post.slug || post.id}/`}>
                  {post.data.title}
                </a>
              </h2>
              {post.data.description && (
                <p class="post-excerpt">{post.data.description}</p>
              )}
            </div>
            <a
              href={`${base}blog/${post.slug || post.id}/`}
              class="read-more"
              aria-label={`Read ${post.data.title}`}
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </a>
          </article>
        ))
      }
    </div>
  </section>
</MainLayout>

<style>
  .blog-container {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: calc(var(--nav-height) + 3rem) var(--content-padding) 4rem;
  }

  .blog-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 2.5rem;
    padding-bottom: 1rem;
    border-bottom: 3px solid var(--color-heading);
  }

  .page-title {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--color-heading);
    letter-spacing: -0.02em;
  }

  .post-count {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .posts-list {
    display: flex;
    flex-direction: column;
  }

  .post-card {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--color-border);
    transition: background-color var(--transition-fast);
  }

  .post-card:hover {
    background-color: var(--color-accent-subtle);
    margin-inline: -1rem;
    padding-inline: 1rem;
    border-radius: 0.5rem;
  }

  .post-number {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-border);
    line-height: 1;
    min-width: 2.5rem;
    padding-top: 0.25rem;
  }

  .post-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  time {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .post-heading {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-heading);
    margin: 0;
  }

  .post-heading a {
    text-decoration: none;
    color: inherit;
    transition: color var(--transition-fast);
  }

  .post-heading a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .post-heading a:hover {
    color: var(--color-accent);
  }

  .post-excerpt {
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    margin: 0;
  }

  .read-more {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--color-accent-subtle);
    color: var(--color-accent);
    flex-shrink: 0;
    align-self: center;
    transition:
      background-color var(--transition-fast),
      transform var(--transition-fast);
    z-index: 1;
    position: relative;
  }

  .post-card:hover .read-more {
    background: var(--color-accent);
    color: white;
    transform: translateX(4px);
  }

  @media (max-width: 600px) {
    .post-number {
      display: none;
    }

    .post-card {
      gap: 1rem;
    }

    .post-heading {
      font-size: 1.1875rem;
    }

    .read-more {
      display: none;
    }
  }
</style>
