---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="For Brands | Intentional Tech Media Kit 2026"
  description="Partner with Intentional Tech — mindful handheld tech content for a calm, engaged audience of adult gamers. Rates and availability on request."
>
  <div class="mk">

    <!-- ── COVER ── -->
    <section class="mk-cover">
      <div class="mk-cover__content">
        <div class="overline overline-light">Media Kit 2026</div>
        <h1 class="mk-cover__headline">Mindful<br>handheld tech.</h1>
        <div class="rule rule-light"></div>
        <p class="mk-cover__sub">Calm, considered takes on portable devices — for real people with real lives.</p>
        <div class="mk-cover__actions">
          <a href="/media-kit-2026.pdf" download class="mk-dl-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Download PDF
          </a>
          <span class="mk-cover__url">intentionaltech.co.uk</span>
        </div>
      </div>
      <div class="mk-cover__img-wrap">
        <img src="/images/switch-2-studio-display.jpg" alt="" class="mk-cover__img">
        <div class="accent-bar" style="z-index:3;"></div>
      </div>
    </section>

    <!-- ── ABOUT ── -->
    <section class="mk-about mk-section--white">
      <div class="accent-bar"></div>
      <div class="mk-about__text">
        <div class="overline">About Me</div>
        <h2 class="h2-purple">Tech's calmest<br>creator.</h2>
        <div class="rule"></div>
        <p class="body-lg"><strong>Intentional Tech</strong> is a YouTube channel and blog by Chris Cowley - a casual gamer, busy dad, and writer from the UK.</p>
        <p class="body-md">Each video pairs with a written article on IntentionalTech.co.uk and an email newsletter. The editorial focus is on helping people make better, more deliberate choices about the handheld devices they add to their lives.</p>
      </div>
      <div class="mk-about__img-wrap">
        <img src="/images/chris.jpg" alt="" class="mk-about__img">
        <div class="mk-about__img-fade"></div>
      </div>
    </section>

    <!-- ── AUDIENCE ── -->
    <section class="mk-section mk-section--lav">
      <div class="accent-bar"></div>
      <div class="mk-section__header">
        <div class="overline">The Audience</div>
        <h2 class="h2-purple">Thoughtful tech fans who use devices on the go (or in bed)...</h2>
      </div>
      <div class="mk-grid-4">
        <div class="mk-card">
          <div class="mk-card__stat">18–44</div>
          <div class="rule rule-purple"></div>
          <div class="mk-card__label">Core age range</div>
          <p class="mk-card__body">Tech lovers with disposable income, who highly value their time</p>
        </div>
        <div class="mk-card">
          <div class="mk-card__stat">Global</div>
          <div class="rule rule-purple"></div>
          <div class="mk-card__label">Audience</div>
          <p class="mk-card__body">Viewers are mostly based in North America and Western Europe</p>
        </div>
        <div class="mk-card">
          <div class="mk-card__stat">Mindful</div>
          <div class="rule rule-purple"></div>
          <div class="mk-card__label">Outlook</div>
          <p class="mk-card__body">Seeking level-headed opinions, not hype-driven reviews</p>
        </div>
        <div class="mk-card">
          <div class="mk-card__stat">Values</div>
          <div class="rule rule-purple"></div>
          <div class="mk-card__label">Beyond Specs</div>
          <p class="mk-card__body">Want authentic, experience-based recommendations</p>
        </div>
      </div>
    </section>

    <!-- ── CONTENT PILLARS ── -->
    <section class="mk-section mk-section--white">
      <div class="accent-bar"></div>
      <div class="mk-section__header">
        <div class="overline">Content Pillars</div>
        <h2 class="h2-purple">Three lenses. One voice.</h2>
      </div>
      <div class="mk-grid-3">
        <div class="mk-pillar">
          <div class="mk-pillar__img-wrap">
            <img src="/images/retroid-pocket-6-review.jpg" alt="">
          </div>
          <div class="mk-pillar__body">
            <span class="tag tag-light">Reviews</span>
            <h3>A Casual Gamer's Review</h3>
            <p>In-depth, long-term reviews of handheld gaming devices. Real takes, not just spec sheets.</p>
          </div>
        </div>
        <div class="mk-pillar">
          <div class="mk-pillar__img-wrap">
            <img src="/images/gamer-dad-survival-guide.jpg" alt="">
          </div>
          <div class="mk-pillar__body">
            <span class="tag tag-light">Lifestyle</span>
            <h3>Intentional Guides</h3>
            <p>How to fit devices into busy adult lives — finding time, shaking distractions, and mindful use.</p>
          </div>
        </div>
        <div class="mk-pillar">
          <div class="mk-pillar__img-wrap">
            <img src="/images/a-casual-gamers-edc-ayn-thor-edition.jpg" alt="">
          </div>
          <div class="mk-pillar__body">
            <span class="tag tag-light">Accessories</span>
            <h3>Everyday Carry</h3>
            <p>Real life use cases for handheld devices, desk setups and tech accessories.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── NUMBERS ── -->
    <section class="mk-section mk-section--navy">
      <div class="accent-bar"></div>
      <div class="mk-section__header mk-section__header--light">
        <div class="overline overline-light">By the Numbers</div>
        <h2 class="h2-white">A growing, grown-up audience.</h2>
      </div>
      <div class="mk-stats">
        <div class="mk-stat">
          <div class="mk-stat__num">17.5k</div>
          <div class="mk-stat__label">YouTube subscribers</div>
          <p class="mk-stat__body">Strong community of handheld tech enthusiasts</p>
        </div>
        <div class="mk-stat mk-stat--bordered">
          <div class="mk-stat__num">400k</div>
          <div class="mk-stat__label">Monthly video views</div>
          <p class="mk-stat__body">High watch time — an engaged, active viewership</p>
        </div>
        <div class="mk-stat mk-stat--bordered">
          <div class="mk-stat__num">40+</div>
          <div class="mk-stat__label">Newsletter subscribers</div>
          <p class="mk-stat__body">Opted-in readers await every new issue</p>
          <div class="mk-stat__badge">Recent launch</div>
        </div>
        <div class="mk-stat mk-stat--bordered">
          <div class="mk-stat__num">20+</div>
          <div class="mk-stat__label">Published articles</div>
          <p class="mk-stat__body">Long-form content ranking in search with evergreen shelf life</p>
          <div class="mk-stat__badge">Recent launch</div>
        </div>
      </div>
    </section>

    <!-- ── EDITORIAL VOICE ── -->
    <section class="mk-voice mk-section--lav">
      <div class="accent-bar"></div>
      <div class="mk-voice__img-wrap">
        <img src="/images/the-handhelds-that-got-me-through-the-year.jpg" alt="">
      </div>
      <div class="mk-voice__text">
        <div class="overline">The editorial voice</div>
        <div class="mk-voice__bar"></div>
        <blockquote class="mk-voice__quote">"The gaming backlog isn't a list of failures. It's a collection of possibilities."</blockquote>
        <p class="body-md">The voice at Intentional Tech is calm, optimistic and honest. Viewers come for the vibe — not the spec sheet.</p>
      </div>
    </section>

    <!-- ── TESTIMONIALS ── -->
    <section class="mk-section mk-section--navy">
      <div class="accent-bar"></div>
      <div class="mk-section__header mk-section__header--light">
        <div class="overline overline-light">What viewers say</div>
        <h2 class="h2-white">In the comments.</h2>
      </div>
      <div class="mk-testimonials">
        <div class="mk-testimonial mk-testimonial--featured">
          <div class="mk-testimonial__bar"></div>
          <blockquote>"Recently found your channel and subscribed. I relate to this — appreciate you sharing your own emotional perspective of video gaming for others to make sense of our own emotions going through life changes. ❤"</blockquote>
          <cite>— @mjs9195 · YouTube</cite>
        </div>
        <div class="mk-testimonials__grid">
          <div class="mk-testimonial mk-testimonial--small">
            <blockquote>"You created a fantastic review video while being incredibly soothing to listen to. You're an extraordinarily relatable guy — once I saw you reading 'The Daily Dad', you had an instant subscriber."</blockquote>
            <cite>— @mikechm74 · YouTube</cite>
          </div>
          <div class="mk-testimonial mk-testimonial--small">
            <blockquote>"Love it when the smaller channels are much better than the larger ones — well done bro, this was quality."</blockquote>
            <cite>— @SwitchUpYt · YouTube</cite>
          </div>
          <div class="mk-testimonial mk-testimonial--small">
            <blockquote>"Fellow dad here — you've got a great narrative voice."</blockquote>
            <cite>— @DrPestilence · YouTube</cite>
          </div>
          <div class="mk-testimonial mk-testimonial--small">
            <blockquote>"You have a superb, calm personality. Subbed and wish you the best on your channel growth, brother!"</blockquote>
            <cite>— @CianSpeaks · YouTube</cite>
          </div>
        </div>
      </div>
    </section>

    <!-- ── COLLABORATION ── -->
    <section class="mk-section mk-section--white">
      <div class="accent-bar"></div>
      <div class="mk-section__header">
        <div class="overline">Working Together</div>
        <h2 class="h2-purple">Collaboration formats.</h2>
      </div>
      <div class="mk-grid-3">
        <div class="mk-collab-card">
          <span class="tag">Sponsored short</span>
          <div class="rule"></div>
          <h3>Vertical video</h3>
          <p>A short, vertical video posted to YouTube Shorts, Instagram and TikTok.</p>
        </div>
        <div class="mk-collab-card">
          <span class="tag">Sponsored video</span>
          <div class="rule"></div>
          <h3>Integrated segment</h3>
          <p>A mid-roll or end-of-video segment within a closely-related organic review or lifestyle piece.</p>
        </div>
        <div class="mk-collab-card">
          <span class="tag">Dedicated longform</span>
          <div class="rule"></div>
          <h3>Full video</h3>
          <p>A long-form showcase published as both a video and companion article.</p>
        </div>
      </div>
      <p class="mk-collab-note">All partnerships require editorial independence. Honest opinions, always. Rates and availability on request.</p>
    </section>

    <!-- ── CONTACT ── -->
    <section class="mk-contact mk-section--navy">
      <div class="accent-bar"></div>
      <div class="overline overline-light mk-contact__overline">Intentional Tech</div>
      <h2 class="mk-contact__headline">Let's make it happen.</h2>
      <div class="rule rule-light mk-contact__rule"></div>
      <p class="mk-contact__sub">If your product fits the Intentional Tech audience, get in touch. Collaborations are selective — and honest.</p>
      <div class="mk-contact__links">
        <div class="mk-contact__link">
          <div class="mk-contact__link-label">Website</div>
          <span class="mk-contact__link-value">intentionaltech.co.uk</span>
        </div>
        <div class="mk-contact__divider"></div>
        <div class="mk-contact__link">
          <div class="mk-contact__link-label">Email</div>
          <a href="mailto:chris@intentionaltech.co.uk" class="mk-contact__link-value">chris@intentionaltech.co.uk</a>
        </div>
        <div class="mk-contact__divider"></div>
        <div class="mk-contact__link">
          <div class="mk-contact__link-label">YouTube</div>
          <a href="https://www.youtube.com/@IntentionalTech" class="mk-contact__link-value" rel="noopener noreferrer" target="_blank">@IntentionalTech</a>
        </div>
      </div>
      <a href="/media-kit-2026.pdf" download class="mk-dl-btn mk-dl-btn--light">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Download PDF
      </a>
    </section>

  </div>
</MainLayout>

<style>
  /* ── Design tokens ── */
  .mk {
    --navy:    #1a1a2e;
    --navy2:   #22223b;
    --lav:     #e6e6fa;
    --purple:  #7b68ee;
    --blue:    #0173ee;
    --blue-lt: #69a2ff;
    --purp-lt: #b8b5ff;
    --fg1:     #2f4f4f;
    --fg2:     #6b7280;
    --hd: "Plus Jakarta Sans", system-ui, sans-serif;
    --bd: "Inter", system-ui, sans-serif;

    padding-top: var(--nav-height);
    font-family: var(--bd);
  }

  /* ── Shared helpers ── */
  .accent-bar {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 5px;
    background: var(--blue);
  }

  .overline {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 1rem;
  }
  .overline-light { color: var(--blue-lt); }

  .rule { width: 56px; height: 4px; background: var(--blue); border-radius: 2px; margin: 1.5rem 0; }
  .rule-light  { background: var(--blue-lt); }
  .rule-purple { background: var(--purple); }

  .tag {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue);
    background: rgba(1,115,238,.10);
    padding: 4px 12px;
    border-radius: 4px;
    border: 1px solid rgba(1,115,238,.22);
  }
  .tag-light {
    color: var(--blue-lt);
    background: rgba(105,162,255,.12);
    border-color: rgba(105,162,255,.3);
  }

  .h2-purple {
    font-family: var(--hd);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    color: var(--purple);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 2rem;
  }
  .h2-white {
    font-family: var(--hd);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    color: #fff;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 2rem;
  }

  .body-lg {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--fg1);
    margin-bottom: 1.25rem;
  }
  .body-md {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--fg2);
  }

  /* ── Section base ── */
  .mk-section {
    position: relative;
    padding: 5rem 2rem 4rem;
  }
  .mk-section--white { background: #fff; }
  .mk-section--lav   { background: var(--lav); }
  .mk-section--navy  { background: var(--navy); }

  .mk-section__header { margin-bottom: 3rem; max-width: 1200px; margin-left: auto; margin-right: auto; }
  .mk-section__header--light .overline { color: var(--blue-lt); }

  /* ── Download button ── */
  .mk-dl-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    background: var(--blue);
    color: #fff;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s;
  }
  .mk-dl-btn:hover { background: #0160cc; }
  .mk-dl-btn--light {
    background: transparent;
    border: 2px solid var(--blue-lt);
    color: var(--blue-lt);
    margin-top: 3rem;
  }
  .mk-dl-btn--light:hover { background: rgba(105,162,255,.15); }

  /* ── Cover ── */
  .mk-cover {
    position: relative;
    background: var(--navy);
    display: flex;
    min-height: 540px;
    overflow: hidden;
  }

  .mk-cover__content {
    position: relative;
    z-index: 2;
    flex: 0 0 auto;
    width: min(560px, 100%);
    padding: 5rem 3rem 4rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .mk-cover__headline {
    font-family: var(--hd);
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 800;
    color: #fff;
    line-height: 1.0;
    letter-spacing: -0.02em;
  }

  .mk-cover__sub {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--purp-lt);
    line-height: 1.6;
  }

  .mk-cover__actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .mk-cover__url {
    font-size: 0.875rem;
    color: rgba(255,255,255,.4);
    letter-spacing: 0.04em;
  }

  .mk-cover__img-wrap {
    flex: 1;
    position: relative;
    min-height: 300px;
  }
  .mk-cover__fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, var(--navy) 0%, transparent 40%);
    z-index: 1;
  }
  .mk-cover__img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.7;
  }

  /* ── About ── */
  .mk-about {
    position: relative;
    background: #fff;
    display: flex;
    overflow: hidden;
  }

  .mk-about__text {
    flex: 0 0 auto;
    width: min(560px, 100%);
    padding: 5rem 3rem 4rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
  }

  .mk-about__img-wrap {
    flex: 1;
    position: relative;
    min-height: 300px;
    overflow: hidden;
  }
  .mk-about__img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  .mk-about__img-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, white 0%, transparent 25%);
  }

  /* ── 4-col grid ── */
  .mk-grid-4 {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .mk-card {
    background: #fff;
    border-radius: 10px;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    box-shadow: 0 4px 16px rgba(0,0,0,.06);
  }

  .mk-card__stat {
    font-family: var(--hd);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 800;
    color: var(--purple);
    line-height: 1;
  }
  .mk-card__label {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--fg1);
  }
  .mk-card__body {
    font-size: 0.875rem;
    color: var(--fg2);
    line-height: 1.55;
  }

  /* ── 3-col grid ── */
  .mk-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* ── Content pillars ── */
  .mk-pillar {
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0,0,0,.07);
    display: flex;
    flex-direction: column;
  }
  .mk-pillar__img-wrap {
    flex-shrink: 0;
  }
  .mk-pillar__img-wrap img {
    width: 100%;
    height: auto;
    display: block;
  }
  .mk-pillar__body {
    background: var(--navy);
    flex: 1;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .mk-pillar__body h3 {
    font-family: var(--hd);
    font-size: 1.125rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.2;
  }
  .mk-pillar__body p {
    font-size: 0.9rem;
    color: var(--purp-lt);
    line-height: 1.6;
  }

  /* ── Stats ── */
  .mk-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    max-width: 1200px;
    margin: 0 auto;
  }

  .mk-stat {
    padding: 2.5rem 2rem;
  }
  .mk-stat--bordered {
    border-left: 1px solid rgba(255,255,255,.12);
  }

  .mk-stat__num {
    font-family: var(--hd);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    color: var(--purp-lt);
    line-height: 1;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }
  .mk-stat__label {
    font-size: 1rem;
    font-weight: 600;
    color: #fff;
    margin-bottom: 0.5rem;
  }
  .mk-stat__body {
    font-size: 0.875rem;
    color: rgba(255,255,255,.5);
    line-height: 1.5;
  }
  .mk-stat__badge {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--blue-lt);
    border: 1px solid rgba(105,162,255,.4);
    border-radius: 4px;
    padding: 2px 8px;
  }

  /* ── Editorial voice ── */
  .mk-voice {
    position: relative;
    background: var(--lav);
    display: flex;
    overflow: hidden;
    min-height: 420px;
  }
  .mk-voice__img-wrap {
    flex: 0 0 auto;
    width: min(400px, 45%);
    position: relative;
    overflow: hidden;
  }
  .mk-voice__img-wrap img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .mk-voice__img-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, transparent 60%, var(--lav) 100%);
  }
  .mk-voice__text {
    flex: 1;
    padding: 4rem 3rem 4rem 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .mk-voice__bar {
    width: 5px;
    height: 64px;
    background: var(--blue);
    border-radius: 3px;
    margin-bottom: 1.5rem;
  }
  .mk-voice__quote {
    font-family: var(--hd);
    font-size: clamp(1.25rem, 2.5vw, 1.875rem);
    font-weight: 700;
    color: var(--purple);
    line-height: 1.35;
    letter-spacing: -0.01em;
    margin-bottom: 1.5rem;
  }

  /* ── Testimonials ── */
  .mk-testimonials {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .mk-testimonial {
    background: var(--navy2);
    border-radius: 10px;
