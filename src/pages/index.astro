---
// src/pages/index.astro
import { getCollection } from "astro:content";
import MainLayout from "../layouts/MainLayout.astro";
import YouTube from "../components/YouTube.astro";
import NewsletterSubscribe from "../components/NewsletterSubscribe.astro";
import { getReadingTime } from "../utils/reading-time";

const allPosts = await getCollection("blog");
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Featured = the single latest post
const featured = sortedPosts[0];
const featuredSlug = featured.id.replace(/\.[^.]+$/, "");

// Reviews slider: reviews-tagged posts, excluding featured, up to 5
const reviewsPosts = sortedPosts
  .filter((p) => p.data.tags?.includes("reviews") && p.id !== featured.id)
  .slice(0, 5);

// Track shown IDs to prevent duplicates
const shownIds = new Set([featured.id, ...reviewsPosts.map((p) => p.id)]);

// Casual Gamer (lifestyle) slider: lifestyle-tagged posts, excluding already shown, up to 5
const lifestylePosts = sortedPosts
  .filter((p) => p.data.tags?.includes("lifestyle") && !shownIds.has(p.id))
  .slice(0, 5);
lifestylePosts.forEach((p) => shownIds.add(p.id));

// Other tags with counts, excluding featured sliders and steam-deck
const tagCountMap = new Map<string, number>();
sortedPosts.forEach((p) => {
  p.data.tags?.forEach((t: string) => tagCountMap.set(t, (tagCountMap.get(t) ?? 0) + 1));
});
const otherTags = [...tagCountMap.entries()]
  .filter(([t]) => t !== "reviews" && t !== "lifestyle" && t !== "steam-deck")
  .sort((a, b) => a[0].localeCompare(b[0]));

const base = import.meta.env.BASE_URL;
---

<MainLayout
  title="Intentional Tech | Handheld Tech for Casual Gamers"
  description="Intentional Tech makes mindful videos on portable devices, from iPads to handheld gaming PCs and everything in between."
>
  <div class="home-wrapper">

    <!-- Page heading -->
    <h1 class="page-heading">Handheld Tech for Casual Gamers</h1>

    <!-- Featured article -->
    <section class="featured-section">
      <div class="section-label">Latest</div>
      <article class="featured-card">
        {featured.data.youtube ? (
          <YouTube
            id={featured.data.youtube}
            title={featured.data.title}
          />
        ) : featured.data.image && (
          <img
            src={featured.data.image}
            alt={featured.data.title}
            class="featured-img"
          />
        )}
        <div class="featured-body">
          <time datetime={featured.data.pubDate.toISOString()}>
            {featured.data.pubDate.toLocaleDateString(undefined, {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
            <span class="meta-sep" aria-hidden="true">&middot;</span>
            {getReadingTime(featured.body)} min read
          </time>
          <h2 class="featured-title">
            <a href={`${base}blog/${featuredSlug}/`}>{featured.data.title}</a>
          </h2>
          {featured.data.description && (
            <p class="featured-desc">{featured.data.description}</p>
          )}
          {featured.data.tags?.length > 0 && (
            <div class="card-tags">
              {featured.data.tags.map((tag: string) => (
                <a href={`${base}tags/${tag}/`} class="tag-pill">{tag}</a>
              ))}
            </div>
          )}
          <a href={`${base}blog/${featuredSlug}/`} class="read-cta">
            Read the article
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round"
                 stroke-linejoin="round">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        </div>
      </article>
    </section>

    <!-- Reviews slider -->
    {reviewsPosts.length > 0 && (
      <section class="slider-section">
        <div class="section-header">
          <h2 class="section-title">Reviews</h2>
          <a href={`${base}tags/reviews/`} class="view-all">
            View all
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round"
                 stroke-linejoin="round">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        </div>
        <div class="slider">
          {reviewsPosts.map((post) => {
            const slug = post.id.replace(/\.[^.]+$/, "");
            return (
              <article class="slider-card">
                {post.data.image && (
                  <img
                    src={post.data.image}
                    alt={post.data.title}
                    class="card-img"
                  />
                )}
                <div class="card-body">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString(undefined, {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    })}
                    <span class="meta-sep" aria-hidden="true">&middot;</span>
                    {getReadingTime(post.body)} min
                  </time>
                  <h3 class="card-title">
                    <a href={`${base}blog/${slug}/`}>{post.data.title}</a>
                  </h3>
                  {post.data.description && (
                    <p class="card-desc">{post.data.description}</p>
                  )}
                  {post.data.tags?.length > 0 && (
                    <div class="card-tags">
                      {post.data.tags.map((tag: string) => (
                        <a href={`${base}tags/${tag}/`} class="tag-pill">{tag}</a>
                      ))}
                    </div>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )}

    <!-- The Casual Gamer (lifestyle) slider -->
    {lifestylePosts.length > 0 && (
      <section class="slider-section">
        <div class="section-header">
          <h2 class="section-title">The Casual Gamer</h2>
          <a href={`${base}tags/lifestyle/`} class="view-all">
            View all
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round"
                 stroke-linejoin="round">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        </div>
        <div class="slider">
          {lifestylePosts.map((post) => {
            const slug = post.id.replace(/\.[^.]+$/, "");
            return (
              <article class="slider-card">
                {post.data.image && (
                  <img
                    src={post.data.image}
                    alt={post.data.title}
                    class="card-img"
                  />
                )}
                <div class="card-body">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString(undefined, {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    })}
                    <span class="meta-sep" aria-hidden="true">&middot;</span>
                    {getReadingTime(post.body)} min
                  </time>
                  <h3 class="card-title">
                    <a href={`${base}blog/${slug}/`}>{post.data.title}</a>
                  </h3>
                  {post.data.description && (
                    <p class="card-desc">{post.data.description}</p>
                  )}
                  {post.data.tags?.length > 0 && (
                    <div class="card-tags">
                      {post.data.tags.map((tag: string) => (
                        <a href={`${base}tags/${tag}/`} class="tag-pill">{tag}</a>
                      ))}
                    </div>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )}

    <!-- More topics -->
    <section class="more-section">
      <div class="section-header">
        <h2 class="section-title">More Topics</h2>
      </div>
      <div class="more-grid">
        {otherTags.map(([tag, count]) => (
          <a href={`${base}tags/${tag}/`} class="tag-card">
            <span class="tag-name">{tag}</span>
            <span class="tag-post-count">{count} {count === 1 ? "post" : "posts"}</span>
          </a>
        ))}
        <a href={`${base}blog`} class="tag-card tag-card--all">
          <span class="tag-name">All Posts</span>
        </a>
        <a href={`${base}tags`} class="tag-card tag-card--all">
          <span class="tag-name">All Topics</span>
        </a>
      </div>
    </section>

    <NewsletterSubscribe />

  </div>
</MainLayout>

<style>
  .home-wrapper {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: calc(var(--nav-height) + 3rem) var(--content-padding) 4rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  /* ── Page heading ── */
  .page-heading {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    color: var(--color-heading);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0;
  }

  /* ── Section label / headers ── */
  .section-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1rem;
    padding-bottom: 0.625rem;
    border-bottom: 2px solid var(--color-border);
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--color-heading);
    letter-spacing: -0.02em;
    margin: 0;
  }

  .view-all {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .view-all:hover {
    color: var(--color-accent);
  }

  /* ── Featured card ── */
  .featured-card :global(.video-container) {
    margin: 0 0 0.5rem;
  }

  .featured-img {
    width: 100%;
    border-radius: 6px;
    object-fit: cover;
    display: block;
    margin-bottom: 0.5rem;
  }

  .featured-card {
    border-left: 4px solid var(--color-accent);
    background: var(--color-accent-subtle);
    border-radius: 0 8px 8px 0;
    padding: 1.75rem 2rem;
  }

  .featured-body {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .featured-body time {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .meta-sep {
    margin: 0 0.25rem;
  }

  .featured-title {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-heading);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .featured-title a {
    text-decoration: none;
    color: inherit;
    transition: color var(--transition-fast);
  }

  .featured-title a:hover {
    color: var(--color-accent);
  }

  .featured-desc {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text);
    margin: 0;
  }

  .read-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    transition: gap var(--transition-fast), color var(--transition-fast);
  }

  .read-cta:hover {
    gap: 0.625rem;
  }

  /* ── Slider ── */
  .slider {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.75rem;
    /* hide scrollbar visually */
    scrollbar-width: none;
  }

  .slider::-webkit-scrollbar {
    display: none;
  }

  .slider-card {
    scroll-snap-align: start;
    flex: 0 0 280px;
    min-width: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .card-img {
    width: 100%;
    height: 160px;
    object-fit: cover;
    display: block;
    flex-shrink: 0;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    flex: 1;
  }

  .slider-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 2px 12px rgba(1, 115, 238, 0.1);
  }

  .slider-card .card-body time {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .card-title {
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-heading);
    margin: 0;
  }

  .card-title a {
    text-decoration: none;
    color: inherit;
    transition: color var(--transition-fast);
  }

  .card-title a:hover {
    color: var(--color-accent);
  }

  .card-desc {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    margin: 0;
    /* clamp to 3 lines */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Tag pills ── */
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: auto;
    padding-top: 0.25rem;
  }

  .tag-pill {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-accent);
    text-decoration: none;
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
    background: var(--color-accent-subtle);
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .tag-pill:hover {
    background: var(--color-accent);
    color: #ffffff;
  }

  /* ── More topics ── */
  .more-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .tag-card {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    border-radius: 6px;
    background: var(--color-accent-subtle);
    text-decoration: none;
    transition:
      background-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .tag-card:hover {
    background: var(--color-accent);
    transform: translateY(-1px);
  }

  .tag-name {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-accent);
  }

  .tag-card:hover .tag-name {
    color: #ffffff;
  }

  .tag-post-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .tag-card:hover .tag-post-count {
    color: rgba(255, 255, 255, 0.8);
  }

  .tag-card--all .tag-name {
    color: var(--color-text);
  }

  .tag-card--all:hover .tag-name {
    color: #ffffff;
  }

  /* ── Mobile ── */
  @media (max-width: 600px) {
    .featured-card {
      padding: 1.25rem 1.25rem 1.25rem 1.5rem;
    }

    .slider-card {
      flex: 0 0 240px;
    }
  }
</style>
