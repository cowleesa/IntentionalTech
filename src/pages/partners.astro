---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Partners | Intentional Tech"
  description="Intentional Tech's Brand Partnerships and Deals."
>
  <section class="support-container">
    <header class="support-header">
      <div class="header-label">Partners</div>
      <h1 class="page-title">Intentional Tech's Partners</h1>
      <p class="page-subtitle">Deals and Recommended Brands.</p>
    </header>

    <div class="support-content">
      <p>
        Intentional Tech is affiliated with a number of brand partners, some
        examples of which can be found here.
      </p>
      <p>
        When you click on an affiliate link and purchase something from
        Intentional Tech's affiliate partners, Intentional Tech may receive
        commission.
      </p>
      <p>
        In some examples, products featured on the site may have been provided by a brand
        for promotional purposes. Posts about these products will contain the tag 'sponsored'
        and feature a disclaimer at the foot of the page. All views are those of Intentional
        Tech.
      </p>

      <ul class="affiliate-list">
        <li>
          <a
            href="https://geni.us/DeskSetup2025"
            target="_blank"
            rel="noopener noreferrer"
          >
            Amazon (affiliate)
          </a>
        </li>
        <li>
          <a
            href="https://nuphy.com?sca_ref=5076574.OLFWd1df6b&utm_source=affiliate&utm_medium=kol&utm_campaign=nuphy_affiliate"
            target="_blank"
            rel="noopener noreferrer"
          >
            NuPhy Studio (affiliate)
          </a>
        </li>
        <li>
          <a
            href="https://ascrono.com/pages/macbook-docking-station?ref=intentionaltech"
            target="_blank"
            rel="noopener noreferrer"
          >
            Ascrono (affiliate)
          </a>
        </li>
        <li>
          <a
            href="https://www.insta360.com/sal/go-3s?utm_term=INRKSQ"
            target="_blank"
            rel="noopener noreferrer"
          >
            Insta360 (affiliate)
          </a>
        </li>
        <li>
          <a
            href="https://www.eloesports.com/Intentional"
            target="_blank"
            rel="noopener noreferrer"
          >
            ELO (affiliate)
          </a>
        </li>
        <li>
          <a
            href="https://www.gpd-minipc.com/?ref=CHRIS"
            target="_blank"
            rel="noopener noreferrer"
          >
            GPD (affiliate)
          </a>
        </li>
        <li>
          <a
            href="https://grovemade.com/?rfsn=7243907.9ca1cb"
            target="_blank"
            rel="noopener noreferrer"
          >
            Grovemade (affiliate)
          </a>
        </li>
        <li>
          <a
            href="https://jpfans.com/register/?ref=800145656"
            target="_blank"
            rel="noopener noreferrer"
          >
            JPfans Sign Up: Coupons for $86(Mercari 50% discount) (affiliate)
          </a>
        </li>
      </ul>

      <p class="thank-you">Thank You!</p>
    </div>
  </section>
</MainLayout>

<style>
  .support-container {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: calc(var(--nav-height) + 3rem) var(--content-padding) 6rem;
  }

  .support-header {
    margin-bottom: 3rem;
    padding-bottom: 1.5rem;
    border-bottom: 3px solid var(--color-heading);
  }

  .header-label {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }

  .page-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    color: var(--color-heading);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .page-subtitle {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .support-content p {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-text);
    margin-bottom: 1.25rem;
  }

  .affiliate-list {
    list-style: none;
    padding: 0;
    margin: 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--color-border);
  }

  .affiliate-list li {
    border-bottom: 1px solid var(--color-border);
  }

  .affiliate-list a {
    display: block;
    padding: 0.875rem 0;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-heading);
    text-decoration: none;
    transition:
      color var(--transition-fast),
      padding-left var(--transition-fast);
  }

  .affiliate-list a:hover {
    color: var(--color-accent);
    padding-left: 0.5rem;
  }

  .thank-you {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--color-heading);
    margin-top: 2rem !important;
    padding-top: 1.5rem;
    border-top: 2px solid var(--color-accent);
    display: inline-block;
  }
</style>
